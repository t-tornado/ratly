{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["step", "comparisons", "summary"],
  "properties": {
    "step": { "type": "string", "const": "compare" },
    "summary": {
      "type": "object",
      "required": ["total", "match", "close", "mismatch"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "match": { "type": "integer", "minimum": 0 },
        "close": { "type": "integer", "minimum": 0 },
        "mismatch": { "type": "integer", "minimum": 0 }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "viewport", "status", "diffPercentage", "screenshotA", "screenshotB"],
        "properties": {
          "component": { "type": "string" },
          "viewport": {
            "type": "object",
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer" },
              "height": { "type": "integer" }
            }
          },
          "status": { "type": "string", "enum": ["match", "close", "mismatch", "error"] },
          "diffPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
          "screenshotA": { "type": "string" },
          "screenshotB": { "type": "string" },
          "diffImage": { "type": "string" },
          "differences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string", "enum": ["color", "spacing", "layout", "typography", "size", "missing", "extra"] },
                "description": { "type": "string" },
                "severity": { "type": "string", "enum": ["minor", "moderate", "major"] }
              }
            }
          }
        }
      }
    }
  }
}

{
  "name": "@ratly/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "nest build && tsc-alias",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",

  },
  "dependencies": {
    "@ratly/core": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fastify": "^5.12.7",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "typescript": "^6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
